# Spotify app client ID (developer.spotify.com/dashboard).
# Add the redirect URI below to the app's settings: http://127.0.0.1:5173/
VITE_SPOTIFY_CLIENT_ID=your_spotify_client_id
# Optional; defaults to the page origin + "/"
# VITE_SPOTIFY_REDIRECT_URI=http://127.0.0.1:5173/
# The FastAPI download server
VITE_SERVER_URL=http://127.0.0.1:8080
# When testing through the Vite dev server (e.g. behind ngrok), use the
# built-in proxy instead: VITE_SERVER_URL=/api
