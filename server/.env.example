# comma-separated origins allowed to call the API (the Vite app)
ALLOWED_ORIGINS=http://127.0.0.1:5173
# parallel YouTube downloads; raise only if the box has spare CPU/bandwidth
MAX_CONCURRENT_DOWNLOADS=3
# require a valid Spotify access token on /resolve and /track
REQUIRE_SPOTIFY_AUTH=true
# download from YouTube over IPv4 (avoids 403s from rotating IPv6 addresses)
FORCE_IPV4=true
